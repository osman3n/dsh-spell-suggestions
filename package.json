{
  "name": "@osman3n/dsh-composer-spellcheck",
  "version": "0.1.0",
  "type": "module",
  "description": "Right-click spelling suggestions in the message composer, with the usual cut/copy/paste/select-all/undo/redo actions kept alongside.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osman3n/dsh-spell-suggestions.git"
  },
  "homepage": "https://github.com/osman3n/dsh-spell-suggestions#readme",
  "bugs": {
    "url": "https://github.com/osman3n/dsh-spell-suggestions/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "spellcheck",
    "composer",
    "context-menu"
  ]
}
